   "$description": "Margine di sezione mobile."
  },
  "space-24": {
   "$type": "dimension",
   "$value": "96px",
   "$description": "Margine di sezione desktop."
  },
  "space-32": {
   "$type": "dimension",
   "$value": "128px",
   "$description": "Respiro di apertura (hero)."
  }
 },
 "radius": {
  "radius-xs": {
   "$type": "dimension",
