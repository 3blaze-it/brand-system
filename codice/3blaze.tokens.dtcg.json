  },
  "radius-sm": {
   "$type": "dimension",
   "$value": "12px",
   "$description": "Input, bottoni secondari."
  },
  "radius-md": {
   "$type": "dimension",
   "$value": "20px",
   "$description": "Card opache."
  },
  "radius-lg": {
   "$type": "dimension",
   "$value": "32px",
